@@ -856,0 +874,11 @@
+sc_recorder_stop_normal(struct sc_recorder *recorder) {
+    sc_mutex_lock(&recorder->mutex);
+    if (!recorder->stopped) {
+        jianku_tail_stop(&recorder->timing, sc_tick_now());
+        recorder->stopped = true;
+        sc_cond_signal(&recorder->cond);
+    }
+    sc_mutex_unlock(&recorder->mutex);
+}
