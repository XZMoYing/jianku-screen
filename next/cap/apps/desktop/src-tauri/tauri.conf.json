{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Jianku Screen Next",
	"identifier": "com.jianku.screen.next",
	"mainBinaryName": "Jianku Screen Next",
	"build": {
		"beforeDevCommand": "bun run localdev",
		"devUrl": "http://localhost:3002",
		"beforeBuildCommand": "bun run turbo build --filter @cap/desktop",
		"frontendDist": "../.output/public"
	},
	"app": {
		"macOSPrivateApi": true,
		"security": {
			"csp": "default-src 'self' ws: ipc: http://ipc.localhost; connect-src 'self' ws: wss: ipc: http://ipc.localhost https://t.cap.so; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'",
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$APPDATA/**",
					"**/*.jpg",
					"**/*.webp",
					"**/*.mp3",
					"**/*.wav",
					"**/*.m4a",
					"**/*.ogg",
					"**/*.flac",
					"**/*.aac",
					"$RESOURCE/**",
					"**/*.riv",
					"$HOME/**"
				]
			}
		}
	},
	"plugins": {
		"updater": {
			"active": false,
			"pubkey": ""
		},
		"deep-link": {
			"desktop": {
				"schemes": ["jianku-screen-next"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": false,
		"targets": "all",
		"externalBin": [
			"binaries/cap-muxer",
			"binaries/cap-exporter",
			"binaries/cap-cli"
		],
		"icon": [
			"icons/jianku/128x128.png",
			"icons/jianku/icon.icns",
			"icons/jianku/icon.ico"
		],
		"resources": {
			"assets/backgrounds/macOS/*": "assets/backgrounds/macOS/",
			"assets/backgrounds/blue/*": "assets/backgrounds/blue/",
			"assets/backgrounds/cities/*": "assets/backgrounds/cities/",
			"assets/backgrounds/dark/*": "assets/backgrounds/dark/",
			"assets/backgrounds/orange/*": "assets/backgrounds/orange/",
			"assets/backgrounds/purple/*": "assets/backgrounds/purple/",
			"../src/assets/rive/*.riv": "assets/rive/",
			"../src/assets/music/*.mp3": "assets/music/"
		},
		"macOS": {
			"minimumSystemVersion": "12.3",
			"dmg": {
				"background": "assets/dmg-background.png",
				"appPosition": {
					"x": 180,
					"y": 140
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 140
				}
			},
			"frameworks": ["../../../target/native-deps/Spacedrive.framework"]
		},
		"windows": {
			"nsis": {
				"headerImage": "assets/nsis-header.bmp",
				"sidebarImage": "assets/nsis-sidebar.bmp",
				"installerIcon": "icons/jianku/icon.ico"
			},
			"wix": {
				"upgradeCode": "5081223e-fbd1-43ae-8fa8-1e1efd4eb1cf",
				"bannerPath": "assets/wix-banner.bmp",
				"dialogImagePath": "assets/wix-dialog.bmp"
			}
		},
		"linux": {
			"deb": {
				"depends": [
					"libwebkit2gtk-4.1-0",
					"libgtk-3-0",
					"libayatana-appindicator3-1",
					"libva2",
					"libva-drm2",
					"pulseaudio-utils",
					"libpipewire-0.3-0",
					"libasound2t64 | libasound2",
					"libxkbcommon0",
					"libxkbcommon-x11-0",
					"libssl3t64 | libssl3"
				],
				"files": {
					"/usr/share/icons/hicolor/scalable/status/so.cap.desktop-tray-default-symbolic.svg": "icons/linux/so.cap.desktop-tray-default-symbolic.svg",
					"/usr/share/icons/hicolor/scalable/status/so.cap.desktop-tray-instant-symbolic.svg": "icons/linux/so.cap.desktop-tray-instant-symbolic.svg",
					"/usr/share/icons/hicolor/scalable/status/so.cap.desktop-tray-screenshot-symbolic.svg": "icons/linux/so.cap.desktop-tray-screenshot-symbolic.svg",
					"/usr/share/icons/hicolor/scalable/status/so.cap.desktop-tray-studio-symbolic.svg": "icons/linux/so.cap.desktop-tray-studio-symbolic.svg",
					"/usr/share/icons/hicolor/scalable/status/so.cap.desktop-tray-stop-symbolic.svg": "icons/linux/so.cap.desktop-tray-stop-symbolic.svg"
				}
			}
		},
		"fileAssociations": []
	}
}
